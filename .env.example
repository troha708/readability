# Supabase (app auth)
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (for migrations only)
# From Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# API.Bible (for downloading formatted Bible text)
# Sign up at https://scripture.api.bible/signup and get your key from the dashboard.
API_BIBLE_KEY=your-api-bible-key

# Supabase service-role key (server-only; bypasses RLS for the seed scripts)
# Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (auth email SMTP + user broadcasts)
# API key from https://resend.com/api-keys; audience ID from Audiences.
# Used by scripts/sync-resend-audience.mjs to keep the broadcast audience
# in step with Supabase accounts.
RESEND_API_KEY=your-resend-api-key
RESEND_AUDIENCE_ID=your-resend-audience-id
